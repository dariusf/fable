{
  // Typechecks the machine-path renderer against fable.d.ts (editors pick
  // this up; CI can run `npx tsc -p jsconfig.json`). interpret.js (the old
  // path) is deliberately excluded — it dies in stage 6.
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    // "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022", "dom"]
  },
  "files": [
    "fable.d.ts",
    "runtime.d.ts",
    "runtime.js",
    "main_browser.js"
  ]
}
